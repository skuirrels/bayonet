<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:AvaloniaFixture"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="240"
        x:Class="AvaloniaFixture.MainWindow"
        x:DataType="local:MainViewModel"
        Title="Avalonia fixture" Width="400" Height="240">
  <Design.DataContext>
    <local:MainViewModel />
  </Design.DataContext>
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="{Binding Greeting}" FontSize="20" />
    <TextBlock Text="{Binding Count}" />
    <Button Content="Click me" />
  </StackPanel>
</Window>
