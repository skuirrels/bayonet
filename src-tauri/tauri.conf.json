{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bayonet",
  "version": "0.1.41",
  "identifier": "io.github.skuirrels.bayonet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Bayonet",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#E9EAEE",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: http: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-src http://127.0.0.1:* openidea-plugin: http://openidea-plugin.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Bayonet contributors",
    "license": "Apache-2.0",
    "shortDescription": "An open-source .NET IDE",
    "longDescription": "Bayonet is an open-source .NET IDE, ported from OpenIDEA. Not affiliated with JetBrains or Microsoft.",
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  },
  "mainBinaryName": "bayonet",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MTA5MDEwODc1NEY2MjIKUldRaTlsU0hFSkFRV09KZStLOWhLSXdjaFh1TnczNjMzTC9QWDZmZ1pTQUgrdFF1KzNlWGczbGQK",
      "endpoints": [
        "https://skuirrels.github.io/bayonet-releases/updates/{{target}}-{{arch}}.json",
        "https://skuirrels.github.io/bayonet-releases/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
